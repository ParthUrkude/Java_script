// Practical 10: Fetch API and jQuery getJSON()

document.body.innerHTML = `
<h2>Fetch API Data</h2>
<div id="fetchData">Loading...</div>

<h2>jQuery JSON Data</h2>
<div id="jqueryData">Loading...</div>
`;

// Fetch API
fetch("https://jsonplaceholder.typicode.com/users")
.then(response => response.json())
.then(data => {

    let output = "<table border='1' cellpadding='8'>";

    output += "<tr><th>ID</th><th>Name</th><th>Email</th></tr>";

    data.forEach(user => {
        output += `
        <tr>
            <td>${user.id}</td>
            <td>${user.name}</td>
            <td>${user.email}</td>
        </tr>`;
    });

    output += "</table>";

    document.getElementById("fetchData").innerHTML = output;
})
.catch(error => console.log(error));

// jQuery getJSON()
if (window.jQuery) {

    $.getJSON("https://jsonplaceholder.typicode.com/users", function(data) {

        let output = "<table border='1' cellpadding='8'>";

        output += "<tr><th>ID</th><th>Name</th><th>Email</th></tr>";

        $.each(data, function(index, user) {
            output += `
            <tr>
                <td>${user.id}</td>
                <td>${user.name}</td>
                <td>${user.email}</td>
            </tr>`;
        });

        output += "</table>";

        $("#jqueryData").html(output);
    });

}
